# Variables d'environnement de Mémoire d'Auxerrois.
# Copier ce fichier et le remplir :
#   - .env.local                → base de PROD (Next en local + `pnpm db:*:prod`)
#   - .env.development.local    → base de DEV (`pnpm dev` + `pnpm db:migrate` / `db:push`)
# Avec Vercel : `vercel env pull .env.local` récupère directement les valeurs de prod.

# --- Base de données (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Site ---
# URL publique, sans "/" final (canonical, sitemap, partage, origines de confiance)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL du serveur d'authentification vue par le navigateur (en général la même que le site)
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Authentification (Better Auth) ---
# Au moins 32 caractères aléatoires : `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Connexion avec Google (console Google Cloud → identifiants OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret partagé avec GitHub Actions (secret CRON_SECRET du dépôt) pour appeler
# /api/cron/publish-scheduled : `openssl rand -base64 32`
CRON_SECRET=

# --- Emails (Resend) ---
RESEND_API_KEY=
# Signature du webhook des emails entrants (/api/emails/inbound)
RESEND_WEBHOOK_SECRET=

# --- Images (Cloudinary) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Limitation de débit (Upstash Redis, facultatif : désactivée si absent) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Statistiques (PostHog, facultatif) ---
NEXT_PUBLIC_POSTHOG_KEY=
# Hôte de ton projet PostHog (ex. https://eu.i.posthog.com ou https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=
# Vues des articles dans le dashboard (facultatif, colonnes masquées sinon) :
# clé personnelle PostHog (Settings → Personal API keys, droit « query:read ») et ID du projet
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Hôte de l'API si différent de NEXT_PUBLIC_POSTHOG_HOST sans « .i » (proxy…)
# POSTHOG_API_HOST=https://eu.posthog.com

# --- Données des scrapers (facultatif : GitHub Pages par défaut) ---
# SCRAPERS_URL=http://localhost:8765

# --- Notifications Discord (facultatif : rien n'est envoyé sans webhook) ---
# Salon → Modifier le salon → Intégrations → Webhooks → Nouveau webhook → Copier l'URL
DISCORD_WEBHOOK_SIGNUPS=
DISCORD_WEBHOOK_LIKES=
# Commentaires publiés et signalés
DISCORD_WEBHOOK_COMMENTS=
# Publications programmées (réussies et échouées)
DISCORD_WEBHOOK_ARTICLES=
